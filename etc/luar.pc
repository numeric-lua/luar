prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include/luar

Name: luar
URL: https://github.com/numeric-lua/luar
Description: LuaR, a Lua 5.5-forward runtime with LuaJIT-style extensions
Version: 0.5.0
Libs: -L${libdir} -lluar -lm
Libs.private: -ldl
Cflags: -I${includedir}
