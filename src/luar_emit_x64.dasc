          | mov rcx, qword [rbx + ((int)LUAR_SLOT(forslot + 2))]
          | add rcx, qword [rbx + ((int)LUAR_SLOT(forslot + 1))]
          | mov qword [rbx + ((int)LUAR_SLOT(forslot + 2))], rcx
          | xor eax, eax
          | add rsp, 16
          | pop rbx
          | pop r15
          | pop r12
          | ret
          |5:
          | mov eax, 1
          | add rsp, 16
          | pop rbx
          | pop r15
          | pop r12
          | ret
          break;
        }
        | mov rax, qword [rbx + ((int)LUAR_SLOT(forslot))]
        | test rax, rax
        | jz >3
        | dec rax
        | mov qword [rbx + ((int)LUAR_SLOT(forslot))], rax
        | mov rcx, qword [rbx + ((int)LUAR_SLOT(forslot + 2))]
        | add rcx, qword [rbx + ((int)LUAR_SLOT(forslot + 1))]
        | mov qword [rbx + ((int)LUAR_SLOT(forslot + 2))], rcx
        | dec r15d
        | jz >6
        | jmp <1
        break;
      case LUAR_IR_EXIT:
      case LUAR_IR_RET:
        break;
      default:
        return 0;
    }
  }
  |3:
  | mov eax, 1
  | add rsp, 16
  | pop rbx
  | pop r15
  | pop r12
  | ret
  |2:
  if (side) {
    | mov eax, r11d
    | neg eax
    | sub eax, 2
  }
  else {
    | mov eax, r11d
    | neg eax
    | sub eax, 2
  }
  | add rsp, 16
  | pop rbx
  | pop r15
  | pop r12
  | ret
  |6:
  | mov eax, 2
  | add rsp, 16
  | pop rbx
  | pop r15
  | pop r12
  | ret
  |8:
  | mov eax, r11d
  | neg eax
  | sub eax, 2
  | add rsp, 16
  | pop rbx
  | pop r15
  | pop r12
  | ret
  return 1;
}

int luari_emit_trace_ir (const LuaR_TraceIR *t, void **code, size_t *size) {
  dasm_State *Dst;
  size_t sz = 0;
  void *mem;
  int status;
  if (t == NULL || code == NULL || size == NULL || t->nins <= 0)
    return 0;
  dasm_init(&Dst, DASM_MAXSECTION);
  dasm_setupglobal(&Dst, NULL, 0);
  dasm_setup(&Dst, luar_emit_actions);
  if (!emit_trace_ir_func(&Dst, t)) {
    dasm_free(&Dst);
    return 0;
  }
  if (dasm_checkstep(&Dst, -1) != 0 ||
      dasm_link(&Dst, &sz) != 0) {
    dasm_free(&Dst);
    return 0;
  }
  mem = mmap(NULL, sz, PROT_READ | PROT_WRITE,
             MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
  if (mem == MAP_FAILED) {
    dasm_free(&Dst);
    return 0;
  }
  status = dasm_encode(&Dst, mem);
  if (status != 0 || mprotect(mem, sz, PROT_READ | PROT_EXEC) != 0) {
    if (status == 0) munmap(mem, sz);
    dasm_free(&Dst);
    return 0;
  }
  dasm_free(&Dst);
  *code = mem;
  *size = sz;
  return 1;
}


LuaR_LoopFn luari_emit_build (const LuaR_LoopDesc *d, size_t *code_size)
{
  dasm_State *Dst;
  size_t size = 0;
  void *mem;
  int status;
  if (d == NULL || code_size == NULL || d->ops == NULL || d->nops <= 0 ||
      (!d->is_while && d->for_a < 0) || d->for_a + 2 > 254)
    return NULL;
  dasm_init(&Dst, DASM_MAXSECTION);
  dasm_setupglobal(&Dst, NULL, 0);
  dasm_setup(&Dst, luar_emit_actions);
  if (d->has_branch && d->npc > 0)
    dasm_growpc(&Dst, (unsigned)d->npc + 2);
  emit_code(&Dst, d);
  if ((status = dasm_checkstep(&Dst, -1)) != 0) {
    dasm_free(&Dst);
    return NULL;
  }
  if ((status = dasm_link(&Dst, &size)) != 0) {
    dasm_free(&Dst);
    return NULL;
  }
  mem = mmap(NULL, size, PROT_READ | PROT_WRITE,
             MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
  if (mem == MAP_FAILED) {
    dasm_free(&Dst);
    return NULL;
  }
  if ((status = dasm_encode(&Dst, mem)) != 0) {
    munmap(mem, size);
    dasm_free(&Dst);
    return NULL;
  }
  if (mprotect(mem, size, PROT_READ | PROT_EXEC) != 0) {
    munmap(mem, size);
    dasm_free(&Dst);
    return NULL;
  }
  dasm_free(&Dst);
  *code_size = size;
  return (LuaR_LoopFn)mem;
}
