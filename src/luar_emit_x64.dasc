static void emit_fast_tsum (dasm_State **Dst, const LuaR_LoopDesc *d)
{
  int isf = (d->ops[0].ta == LUAR_T_FLOAT);
  | push rbx
  | mov rbx, rdi
  | push r12
  | push r13
  | push r14
  | push r15
  | mov r12, qword [rbx + ((int)LUAR_SLOT(d->for_a))]
  | mov r13, qword [rbx + ((int)LUAR_SLOT(d->ft_idx))]
  | mov r14, qword [rbx + ((int)LUAR_SLOT(d->for_a + 1))]
  if (!isf) {
    | mov r15, qword [rbx + ((int)LUAR_SLOT(d->ft_acc))]
  }
  else {
    | movsd xmm0, qword [rbx + ((int)LUAR_SLOT(d->ft_acc))]
  }
  emit_guards(Dst, d);
  | mov r8, qword [rbx + ((int)LUAR_SLOT(d->ft_table))]
  | mov rax, qword [r8 + ((int)d->table_metatable_off)]
  | test rax, rax
  | jnz >3
  | mov r9, qword [r8 + ((int)d->table_array_off)]
  | mov r10d, dword [r8 + ((int)d->table_asize_off)]
  /* This fast path only handles step 1 and pre-validates the whole range. */
  | cmp r14, 1
  | jne >3
  | cmp r13, 1
  | jl >3
  | mov rax, r13
  | add rax, r12
  | cmp rax, r10
  | ja >3
  | mov rcx, r13
  | dec rcx
  | shl rcx, 4
  | add rcx, r9
  | mov rdx, r12
  | inc rdx
  |4:
  | cmp byte [rcx + 8], ((int)d->tag_int)
  | jne >3
  | add rcx, 16
  | dec rdx
  | jnz <4
  | mov r11, r13
  | dec r11
  | shl r11, 4
  | add r11, r9
  |1:
  if (!isf) {
    | add r15, qword [r11]
  }
  else {
    | cvtsi2sd xmm1, qword [r11]
    | addsd xmm0, xmm1
  }
  | add r11, 16
  | test r12, r12
  | jz >2
  | dec r12
  | add r13, d->fw_step
  | jmp <1
  |2:
  | mov qword [rbx + ((int)LUAR_SLOT(d->for_a))], r12
  | mov qword [rbx + ((int)LUAR_SLOT(d->for_a + 2))], r13
  if (!isf) {
    | mov qword [rbx + ((int)LUAR_SLOT(d->ft_acc))], r15
  }
  else {
    | movsd qword [rbx + ((int)LUAR_SLOT(d->ft_acc))], xmm0
  }
  | mov eax, 1
  | pop r15
  | pop r14
  | pop r13
  | pop r12
  | pop rbx
  | ret
  |3:
  | mov qword [rbx + ((int)LUAR_SLOT(d->for_a))], r12
  | mov qword [rbx + ((int)LUAR_SLOT(d->for_a + 2))], r13
  if (!isf) {
    | mov qword [rbx + ((int)LUAR_SLOT(d->ft_acc))], r15
  }
  else {
    | movsd qword [rbx + ((int)LUAR_SLOT(d->ft_acc))], xmm0
  }
  | xor eax, eax
  | pop r15
  | pop r14
  | pop r13
  | pop r12
  | pop rbx
  | ret
}

static void emit_fast_while (dasm_State **Dst, const LuaR_LoopDesc *d)
{
  int is_lt = (d->fw_kind == LUAR_OP_LT);
  | push rbx
  | mov rbx, rdi
  | push r12
  | push r13
  | push r14
  if (d->fw_float) {
    union { double d; uint64_t u; } cv;
    cv.d = d->fw_const;
    | movsd xmm0, qword [rbx + ((int)LUAR_SLOT(d->fw_acc))]
    | mov64 rax, cv.u
    | movq xmm2, rax
  }
  else {
    | mov r12, qword [rbx + ((int)LUAR_SLOT(d->fw_acc))]
  }
  | mov r13, qword [rbx + ((int)LUAR_SLOT(d->fw_idx))]
  if (d->fw_limit == 0xFF) {
    | mov64 r14, d->fw_imm
  }
  else {
    | mov r14, qword [rbx + ((int)LUAR_SLOT(d->fw_limit))]
  }
  emit_guards(Dst, d);
  |1:
  | cmp r13, r14
  if (is_lt) {
    if (d->fw_k) {
      | jl >2
    }
    else {
      | jge >2
    }
  }
  else {
    if (d->fw_k) {
      | jle >2
    }
    else {
      | jg >2
    }
  }
  if (d->fw_float) {
    | cvtsi2sd xmm1, r13
    if (d->fw_prod) {
      | mulsd xmm0, xmm1
    }
    else if (d->fw_sub) {
      | subsd xmm0, xmm1
    }
    else if (d->fw_div) {
      | divsd xmm0, xmm1
    }
    else if (d->fw_square) {
      | mulsd xmm1, xmm1
      | addsd xmm0, xmm1
    }
    else if (d->fw_linear) {
      | mulsd xmm1, xmm2
      | addsd xmm0, xmm1
    }
    else {
      | addsd xmm0, xmm1
    }
  }
  else if (d->fw_prod) {
    | imul r12, r13
  }
  else if (d->fw_sub) {
    | sub r12, r13
  }
  else if (d->fw_square) {
    | mov rcx, r13
    | imul rcx, r13
    | add r12, rcx
  }
  else {
    | add r12, r13
  }
  | add r13, d->fw_step
  | jmp <1
  |2:
  if (d->fw_float) {
    | movsd qword [rbx + ((int)LUAR_SLOT(d->fw_acc))], xmm0
  }
  else {
    | mov qword [rbx + ((int)LUAR_SLOT(d->fw_acc))], r12
  }
  | mov qword [rbx + ((int)LUAR_SLOT(d->fw_idx))], r13
  | mov eax, 1
  | pop r14
  | pop r13
  | pop r12
  | pop rbx
  | ret
  |3:
  | xor eax, eax
  | pop r14
  | pop r13
  | pop r12
  | pop rbx
  | ret
}

static void emit_fast_sq (dasm_State **Dst, const LuaR_LoopDesc *d)
{
  | push rbx
  | mov rbx, rdi
  | push r12
  | push r13
  | push r14
  | push r15
  | mov r12, qword [rbx + ((int)LUAR_SLOT(d->for_a))]
  | mov r13, qword [rbx + ((int)LUAR_SLOT(d->for_a + 2))]
  | mov r14, qword [rbx + ((int)LUAR_SLOT(d->for_a + 1))]
  if (d->fs_float) {
    | movsd xmm0, qword [rbx + ((int)LUAR_SLOT(d->fs_acc))]
  }
  else {
    | mov r15, qword [rbx + ((int)LUAR_SLOT(d->fs_acc))]
  }
  emit_guards(Dst, d);
  |1:
  if (d->fs_float) {
    | cvtsi2sd xmm1, r13
    | mulsd xmm1, xmm1
    | addsd xmm0, xmm1
  }
  else {
    | mov rcx, r13
    | imul rcx, r13
    | add r15, rcx
  }
  | test r12, r12
  | jz >2
  | dec r12
  | add r13, r14
  | jmp <1
  |2:
  | mov qword [rbx + ((int)LUAR_SLOT(d->for_a))], r12
  | mov qword [rbx + ((int)LUAR_SLOT(d->for_a + 2))], r13
  if (d->fs_float) {
    | movsd qword [rbx + ((int)LUAR_SLOT(d->fs_acc))], xmm0
  }
  else {
    | mov qword [rbx + ((int)LUAR_SLOT(d->fs_acc))], r15
  }
  | mov eax, 1
  | pop r15
  | pop r14
  | pop r13
  | pop r12
  | pop rbx
  | ret
  |3:
  | xor eax, eax
  | pop r15
  | pop r14
  | pop r13
  | pop r12
  | pop rbx
  | ret
}

static void emit_fast_prod (dasm_State **Dst, const LuaR_LoopDesc *d)
{
  | push rbx
  | mov rbx, rdi
  | push r12
  | push r13
  | push r14
  | push r15
  | mov r12, qword [rbx + ((int)LUAR_SLOT(d->for_a))]
  | mov r13, qword [rbx + ((int)LUAR_SLOT(d->for_a + 2))]
  | mov r14, qword [rbx + ((int)LUAR_SLOT(d->for_a + 1))]
  if (d->fp_float) {
    | movsd xmm0, qword [rbx + ((int)LUAR_SLOT(d->fp_acc))]
  }
  else {
    | mov r15, qword [rbx + ((int)LUAR_SLOT(d->fp_acc))]
  }
  emit_guards(Dst, d);
  |1:
  if (d->fp_float) {
    | cvtsi2sd xmm1, r13
    if (d->fp_div)
      | divsd xmm0, xmm1
    else
      | mulsd xmm0, xmm1
  }
  else {
    | imul r15, r13
  }
  | test r12, r12
  | jz >2
  | dec r12
  | add r13, r14
  | jmp <1
  |2:
  | mov qword [rbx + ((int)LUAR_SLOT(d->for_a))], r12
  | mov qword [rbx + ((int)LUAR_SLOT(d->for_a + 2))], r13
  if (d->fp_float) {
    | movsd qword [rbx + ((int)LUAR_SLOT(d->fp_acc))], xmm0
  }
  else {
    | mov qword [rbx + ((int)LUAR_SLOT(d->fp_acc))], r15
  }
  | mov eax, 1
  | pop r15
  | pop r14
  | pop r13
  | pop r12
  | pop rbx
  | ret
  |3:
  | xor eax, eax
  | pop r15
  | pop r14
  | pop r13
  | pop r12
  | pop rbx
  | ret
}

static void emit_fast_sub (dasm_State **Dst, const LuaR_LoopDesc *d)
{
  | push rbx
  | mov rbx, rdi
  | push r12
  | push r13
  | push r14
  | push r15
  | mov r12, qword [rbx + ((int)LUAR_SLOT(d->for_a))]
  | mov r13, qword [rbx + ((int)LUAR_SLOT(d->for_a + 2))]
  | mov r14, qword [rbx + ((int)LUAR_SLOT(d->for_a + 1))]
  if (d->fsb_float) {
    | movsd xmm0, qword [rbx + ((int)LUAR_SLOT(d->fsb_acc))]
  }
  else {
    | mov r15, qword [rbx + ((int)LUAR_SLOT(d->fsb_acc))]
  }
  emit_guards(Dst, d);
  |1:
  if (d->fsb_float) {
    | cvtsi2sd xmm1, r13
    | subsd xmm0, xmm1
  }
  else {
    | sub r15, r13
  }
  | test r12, r12
  | jz >2
  | dec r12
  | add r13, r14
  | jmp <1
  |2:
  | mov qword [rbx + ((int)LUAR_SLOT(d->for_a))], r12
  | mov qword [rbx + ((int)LUAR_SLOT(d->for_a + 2))], r13
  if (d->fsb_float) {
    | movsd qword [rbx + ((int)LUAR_SLOT(d->fsb_acc))], xmm0
  }
  else {
    | mov qword [rbx + ((int)LUAR_SLOT(d->fsb_acc))], r15
  }
  | mov eax, 1
  | pop r15
  | pop r14
  | pop r13
  | pop r12
  | pop rbx
  | ret
  |3:
  | xor eax, eax
  | pop r15
  | pop r14
  | pop r13
  | pop r12
  | pop rbx
  | ret
}

static void emit_fast_repeat (dasm_State **Dst, const LuaR_LoopDesc *d)
{
  int kind = d->fr_kind, k = d->fr_k;
  | push rbx
  | mov rbx, rdi
  | push r13
  | push r14
  | push r15
  | mov r13, qword [rbx + ((int)LUAR_SLOT(d->fr_idx))]
  if (d->fr_float) {
    | movsd xmm0, qword [rbx + ((int)LUAR_SLOT(d->fr_acc))]
  }
  else {
    | mov r15, qword [rbx + ((int)LUAR_SLOT(d->fr_acc))]
  }
  if (d->fr_limit != 0xFF) {
    | mov r14, qword [rbx + ((int)LUAR_SLOT(d->fr_limit))]
  }
  else {
    | mov64 r14, d->fr_immediate
  }
  emit_guards(Dst, d);
  |1:
  | add r13, d->fr_step
  if (d->fr_float) {
    | cvtsi2sd xmm1, r13
    if (d->fr_op == 1) {
      | subsd xmm0, xmm1
    }
    else if (d->fr_op == 2) {
      | mulsd xmm0, xmm1
    }
    else if (d->fr_op == 3) {
      | mulsd xmm1, xmm1
      | addsd xmm0, xmm1
    }
    else if (d->fr_op == 4) {
      | divsd xmm0, xmm1
    }
    else {
      | addsd xmm0, xmm1
    }
  }
  else if (d->fr_op == 1) {
    | sub r15, r13
  }
  else if (d->fr_op == 2) {
    | imul r15, r13
  }
  else if (d->fr_op == 3) {
    | mov rcx, r13
    | imul rcx, r13
    | add r15, rcx
  }
  else {
    | add r15, r13
  }
  if (d->fr_idx_left) {
    | cmp r13, r14
  }
  else {
    | cmp r14, r13
  }
  if (kind == LUAR_OP_LT) {
    if (k) {
      | jl <1
    }
    else {
      | jge <1
    }
  }
  else if (kind == LUAR_OP_LE) {
    if (k) {
      | jle <1
    }
    else {
      | jg <1
    }
  }
  else if (kind == LUAR_OP_GT) {
    if (k) {
      | jg <1
    }
    else {
      | jle <1
    }
  }
  else if (kind == LUAR_OP_GE) {
    if (k) {
      | jge <1
    }
    else {
      | jl <1
    }
  }
  else {
    if (k) {
      | je <1
    }
    else {
      | jne <1
    }
  }
  | mov qword [rbx + ((int)LUAR_SLOT(d->fr_idx))], r13
  if (d->fr_float) {
    | movsd qword [rbx + ((int)LUAR_SLOT(d->fr_acc))], xmm0
  }
  else {
    | mov qword [rbx + ((int)LUAR_SLOT(d->fr_acc))], r15
  }
  | mov eax, 1
  | pop r15
  | pop r14
  | pop r13
  | pop rbx
  | ret
  |3:
  |2:
  | xor eax, eax
  | pop r15
  | pop r14
  | pop r13
  | pop rbx
  | ret
}

static void emit_partial_code (dasm_State **Dst, const LuaR_LoopDesc *d)
{
  | push rbx
  | mov rbx, rdi
  emit_guards(Dst, d);
  emit_body(Dst, d);
  | mov eax, -((int)d->exit_pc + 2)
  | pop rbx
  | ret
  |3:
  | xor eax, eax
  | pop rbx
  | ret
}

static void emit_code (dasm_State **Dst, const LuaR_LoopDesc *d)
{
  if (d->partial) {
    emit_partial_code(Dst, d);
    return;
  }
  if (d->fast_repeat) {
    emit_fast_repeat(Dst, d);
    return;
  }
  if (d->fast_sub) {
    emit_fast_sub(Dst, d);
    return;
  }
  if (d->fast_prod) {
    emit_fast_prod(Dst, d);
    return;
  }
  if (d->fast_sq) {
    emit_fast_sq(Dst, d);
    return;
  }
  if (d->fast_while) {
    emit_fast_while(Dst, d);
    return;
  }
  if (d->fast_tsum) {
    emit_fast_tsum(Dst, d);
    return;
  }
  if (d->fast_meta) {
    emit_fast_meta(Dst, d);
    return;
  }
  if (d->fast_closure) {
    emit_fast_closure(Dst, d);
    return;
  }
  if (d->fast_int) {
    emit_fast_int(Dst, d);
    return;
  }
  if (d->fast_fill) {
    emit_fast_fill(Dst, d);
    return;
  }
  if (d->fast_float) {
    emit_fast_float(Dst, d);
    return;
  }
  if (d->has_branch) {
    emit_branch_code(Dst, d);
    return;
  }
  | push rbx
  | mov rbx, rdi
  emit_guards(Dst, d);
  |1:
